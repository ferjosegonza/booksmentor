# Staging Environment
NODE_ENV="staging"
PORT=3001

# Database
DATABASE_URL="mysql://booksmentor:password@staging-db.example.com:3306/booksmentor_staging"

# Redis
REDIS_HOST="staging-redis.example.com"
REDIS_PORT=6379
REDIS_PASSWORD="staging-redis-password"
REDIS_DB=0

# JWT
JWT_SECRET="staging-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Google OAuth
GOOGLE_CLIENT_ID="staging-google-client-id"
GOOGLE_CLIENT_SECRET="staging-google-client-secret"
GOOGLE_CALLBACK_URL="https://staging.booksmentor.com/auth/google/callback"

# AI Providers
GEMINI_API_KEY="staging-gemini-api-key"
GROQ_API_KEY="staging-groq-api-key"
HUGGINGFACE_API_KEY="staging-huggingface-api-key"

# Email Providers
RESEND_API_KEY="staging-resend-api-key"
BREVO_API_KEY="staging-brevo-api-key"
AWS_ACCESS_KEY_ID="staging-aws-access-key"
AWS_SECRET_ACCESS_KEY="staging-aws-secret-key"
AWS_REGION="us-east-1"

# Payment Providers
MERCADOPAGO_ACCESS_TOKEN="staging-mercadopago-token"
PAYPAL_CLIENT_ID="staging-paypal-client-id"
PAYPAL_CLIENT_SECRET="staging-paypal-client-secret"
STRIPE_SECRET_KEY="staging-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="staging-stripe-webhook-secret"

# Expo Push Notifications
EXPO_ACCESS_TOKEN="staging-expo-access-token"

# Google Books API
GOOGLE_BOOKS_API_KEY=""

# Frontend URL
FRONTEND_URL="https://staging.booksmentor.com"
