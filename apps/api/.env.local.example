# Local Development Environment
NODE_ENV="development"
PORT=3001

# Database
DATABASE_URL="mysql://booksmentor:booksmentor@localhost:3306/booksmentor"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# JWT
JWT_SECRET="local-dev-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Google OAuth
GOOGLE_CLIENT_ID="your-local-google-client-id"
GOOGLE_CLIENT_SECRET="your-local-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# AI Providers (Optional for local development)
GEMINI_API_KEY=""
GROQ_API_KEY=""
HUGGINGFACE_API_KEY=""

# Email Providers (Optional for local development)
RESEND_API_KEY=""
BREVO_API_KEY=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# Payment Providers (Optional for local development)
MERCADOPAGO_ACCESS_TOKEN=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Expo Push Notifications
EXPO_ACCESS_TOKEN=""

# Google Books API
GOOGLE_BOOKS_API_KEY=""

# Frontend URL
FRONTEND_URL="http://localhost:3000"
